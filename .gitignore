# ==========================================================
# MCL - Meter Central Laboratory System
# Git Ignore Configuration
# Windows Development / Linux Production
# ==========================================================

# Environment and credentials
.env
.env.*
!.env.example
.env.example
/auth.json
*.key
*.pem
*.p12
*.pfx

# Logs
*.log
/storage/logs/*
!/storage/logs/.gitignore

# Laravel compiled views
/storage/framework/views/*
!/storage/framework/views/.gitignore

# Laravel cache
/storage/framework/cache/*
!/storage/framework/cache/.gitignore

# Laravel sessions
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore

# Laravel testing
.phpunit.result.cache
/.phpunit.cache

# Dependencies
/node_modules
/vendor

# Frontend generated assets
/public/build
/public/hot
/public/storage
/public/fonts-manifest.dev.json

# Laravel runtime files
/storage/*.key
/storage/pail

# Development tools
/.codex
/.cursor/
/.idea
/.nova
/.vscode
/.zed
.phpactor.json
_ide_helper.php

# Operating system files
.DS_Store
Thumbs.db

# Local development
Homestead.json
Homestead.yaml

# Sensitive manuals and local documentation
/Manuals/

# Database backups and dumps
*.sql
*.sql.gz
*.bak
*.backup
*.dump
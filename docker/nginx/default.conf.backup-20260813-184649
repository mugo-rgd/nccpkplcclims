server {
    listen 80;
    listen [::]:80;

    server_name meterlab.kplcinstitute.ac.ke;

    root /var/www/html/public;
    index index.php index.html;

    client_max_body_size 25M;

    # ------------------------------------------------------------
    # Let's Encrypt ACME challenge
    # ------------------------------------------------------------
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    # ------------------------------------------------------------
    # Laravel
    # ------------------------------------------------------------
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # ------------------------------------------------------------
    # PHP-FPM
    # ------------------------------------------------------------
    location ~ \.php$ {
        include fastcgi_params;

        fastcgi_pass app:9000;
        fastcgi_index index.php;

        fastcgi_param SCRIPT_FILENAME
            $document_root$fastcgi_script_name;

        fastcgi_param PATH_INFO
            $fastcgi_path_info;
    }

    # ------------------------------------------------------------
    # Security
    # ------------------------------------------------------------
    location ~* /(composer\.(json|lock)|package\.json|artisan|\.env)$ {
        deny all;
    }

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # ============================================================
    # Public Laravel storage
    # ============================================================

    location /storage/ {
        try_files $uri =404;
    }

    # ============================================================
    # Static assets
    # ============================================================

    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot|webp)$ {
        expires 30d;
        access_log off;

        add_header Cache-Control "public, immutable";

        try_files $uri =404;
    }

    # ============================================================
    # Block hidden files
    # ============================================================

    location ~ /\.(?!well-known).* {
        deny all;
    }

    # ============================================================
    # Block sensitive Laravel/application files
    # ============================================================

    location ~* /(composer\.(json|lock)|package(-lock)?\.json|artisan|\.env)$ {
        deny all;
    }

    # ============================================================
    # Security headers
    # ============================================================

    add_header X-Frame-Options
        "SAMEORIGIN"
        always;

    add_header X-Content-Type-Options
        "nosniff"
        always;

    add_header Referrer-Policy
        "strict-origin-when-cross-origin"
        always;

    # ============================================================
    # Logs
    # ============================================================

    access_log /var/log/nginx/access.log;

    error_log /var/log/nginx/error.log warn;
}

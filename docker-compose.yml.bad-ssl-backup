services:

  # ==============================================================
  # Laravel PHP-FPM Application
  # ==============================================================

  app:
    build:
      context: .
      dockerfile: Dockerfile

    container_name: meterlab-app

    restart: unless-stopped

    working_dir: /var/www/html

    env_file:
      - .env

    volumes:
      - ./:/var/www/html
      - vendor_data:/var/www/html/vendor
      - build_data:/var/www/html/public/build

    depends_on:
      db:
        condition: service_healthy

    networks:
      - meterlab-network


  # ==============================================================
  # Nginx
  # ==============================================================

nginx:
  image: nginx:alpine
  container_name: meterlab-nginx
  restart: unless-stopped

  ports:
    - "80:80"
    - "443:443"

  volumes:
    - ./:/var/www/html:ro
    - ./docker/nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
    - ./docker/certbot/www:/var/www/certbot:ro
    - ./docker/certbot/conf:/etc/letsencrypt:ro

  depends_on:
    - app

  networks:
    - meterlab-network

  # ==============================================================
  # MySQL
  # ==============================================================

  db:
    image: mysql:8.4

    container_name: meterlab-db

    restart: unless-stopped

    environment:
      MYSQL_DATABASE: ${DB_DATABASE}
      MYSQL_USER: ${DB_USERNAME}
      MYSQL_PASSWORD: ${DB_PASSWORD}
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
      TZ: Africa/Nairobi

    command:
      - --character-set-server=utf8mb4
      - --collation-server=utf8mb4_unicode_ci

    volumes:
      - mysql_data:/var/lib/mysql

    healthcheck:
      test:
        [
          "CMD-SHELL",
          "mysqladmin ping -h localhost -u root -p$$MYSQL_ROOT_PASSWORD || exit 1"
        ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 40s

    networks:
      - meterlab-network


  # ==============================================================
  # Laravel Queue Worker
  # ==============================================================

  worker:
    build:
      context: .
      dockerfile: Dockerfile

    container_name: meterlab-worker

    restart: unless-stopped

    working_dir: /var/www/html

    env_file:
      - .env

    command:
      [
        "php",
        "artisan",
        "queue:work",
        "--sleep=3",
        "--tries=3",
        "--timeout=300"
      ]

    volumes:
      - ./:/var/www/html
      - vendor_data:/var/www/html/vendor
      - build_data:/var/www/html/public/build

    depends_on:
      db:
        condition: service_healthy

    networks:
      - meterlab-network


  # ==============================================================
  # Laravel Scheduler
  # ==============================================================

  scheduler:
    build:
      context: .
      dockerfile: Dockerfile

    container_name: meterlab-scheduler

    restart: unless-stopped

    working_dir: /var/www/html

    env_file:
      - .env

    command:
      [
        "php",
        "artisan",
        "schedule:work"
      ]

    volumes:
      - ./:/var/www/html
      - vendor_data:/var/www/html/vendor
      - build_data:/var/www/html/public/build

    depends_on:
      db:
        condition: service_healthy

    networks:
      - meterlab-network


# ==================================================================
# Networks
# ==================================================================

networks:

  meterlab-network:
    driver: bridge


# ==================================================================
# Persistent Volumes
# ==================================================================

volumes:

  mysql_data:

  vendor_data:

  build_data:
